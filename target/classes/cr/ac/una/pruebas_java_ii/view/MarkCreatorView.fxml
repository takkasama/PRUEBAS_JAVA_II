<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import io.github.palexdev.materialfx.controls.MFXTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="517.0" prefWidth="673.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cr.ac.una.pruebas_java_ii.controller.MarkCreatorController">


<fx:define>
    <ToggleGroup fx:id="shiftGroup" />
</fx:define>

<children>

    <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="25.0" AnchorPane.leftAnchor="35.0" AnchorPane.rightAnchor="35.0" AnchorPane.topAnchor="25.0">

        <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
        </padding>

        <!-- TITLE -->

        <Label style="                    -fx-font-size: 26px;                    -fx-font-weight: bold;                    -fx-text-fill: #242424;                " text="Mark Test" />

        <Label fx:id="lblemployeeInfo" style="                    -fx-font-size: 12px;                    -fx-text-fill: #777777;                " text="Registro rápido de entrada y salida" />

        <Separator />

        <!-- EMPLOYEE -->

        <MFXTextField fx:id="txtEmployeeId" floatingText="Employee ID" maxWidth="Infinity" onKeyPressed="#onKeyPressedTxtIdEmployee" prefHeight="54.0" prefWidth="528.0" promptText="Enter employee ID" />

        <!-- SHIFT -->

        <Label style="                    -fx-font-size: 14px;                    -fx-font-weight: bold;                    -fx-text-fill: #444444;                " text="Turno" />

        <HBox alignment="CENTER" spacing="10.0">

            <ToggleButton fx:id="tglShiftDay" prefHeight="40.0" prefWidth="140.0" selected="true" text="Day">
               <toggleGroup>
                  <ToggleGroup fx:id="shiftGroup" />
               </toggleGroup></ToggleButton>

            <ToggleButton fx:id="tglShiftNight" prefHeight="40.0" prefWidth="140.0" text="Night" toggleGroup="$shiftGroup" />

        </HBox>

        <Separator />

        <!-- MARK ACTIONS -->

        <HBox alignment="CENTER" spacing="15.0">

            <MFXButton fx:id="btnEntry" onAction="#onActionEntry" prefHeight="65.0" prefWidth="200.0" style="                            -fx-background-color: #2e7d32;                            -fx-text-fill: white;                            -fx-font-size: 16px;                            -fx-font-weight: bold;                            -fx-background-radius: 8px;                        " text="ENTRADA" />

            <MFXButton fx:id="btnExit" onAction="#onActionExit" prefHeight="65.0" prefWidth="200.0" style="                            -fx-background-color: #c62828;                            -fx-text-fill: white;                            -fx-font-size: 16px;                            -fx-font-weight: bold;                            -fx-background-radius: 8px;                        " text="SALIDA" />

        </HBox>

        <!-- TEST STATUS -->

        <Label fx:id="lblStatus" style="                    -fx-font-size: 12px;                    -fx-text-fill: #777777;                " text="Ready" wrapText="true" />

    </VBox>

</children>


</AnchorPane>
